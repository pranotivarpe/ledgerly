NODE_ENV=development
PORT=4100
# Public URLs (used for CORS, links in emails, Stripe redirects)
WEB_URL=http://localhost:5180
API_URL=http://localhost:4100

DATABASE_URL=postgresql://USER@localhost:5432/ledgerly

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# Optional — without it, emails are printed to the console and viewable at /api/dev/emails
RESEND_API_KEY=
EMAIL_FROM="Ledgerly <onboarding@resend.dev>"

# Stripe (test mode). Run `npm run stripe:setup -w apps/api` once to create products & prices.
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:4100/api/webhooks/stripe` or the Dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# Background jobs. Single server: leave JOBS_ENABLED=true. Serverless/multiple instances:
# set JOBS_ENABLED=false and call POST /api/jobs/overdue-reminders hourly with
# "Authorization: Bearer $CRON_SECRET".
JOBS_ENABLED=true
CRON_SECRET=

# Public demo: one-click demo logins + daily reset of the demo workspace
DEMO_ENABLED=true
