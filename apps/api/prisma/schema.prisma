// Ledgerly data model
//
// Multi-tenancy: shared database, shared schema. Every tenant-owned table carries
// an `organizationId` and is only ever queried through the tenant-scoped data
// access layer (see src/lib/tenant.ts).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum Plan {
  FREE
  PRO
  TEAM
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum PaymentMethod {
  STRIPE
  MANUAL
}

// ─── Identity ────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String?
  avatarUrl     String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships   Membership[]
  sessions      Session[]
  sentInvites   Invitation[]  @relation("InvitedBy")
  activity      ActivityLog[]
}

// Refresh-token sessions (rotated on every refresh, revocable).
model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Tenancy ─────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  brandColor String  @default("#4f46e5")
  currency  String   @default("USD")
  address   String?
  invoicePrefix     String @default("INV")
  nextInvoiceNumber Int    @default(1)

  // Billing (Stripe is the source of truth; these are synced via webhooks)
  plan                 Plan                @default(FREE)
  stripeCustomerId     String?             @unique
  stripeSubscriptionId String?             @unique
  subscriptionStatus   SubscriptionStatus?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean             @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  invitations Invitation[]
  clients     Client[]
  projects    Project[]
  invoices    Invoice[]
  payments    Payment[]
  activity    ActivityLog[]
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role      @default(MEMBER)
  tokenHash      String    @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

// ─── Agency domain ───────────────────────────────────────────────────────────

model Client {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String
  company        String?
  phone          String?
  address        String?
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     ClientContact[]
  projects     Project[]
  invoices     Invoice[]

  @@index([organizationId])
}

// People at a client company who can log in to the client portal (magic link).
model ClientContact {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  email          String
  name           String
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())

  client     Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  magicLinks PortalMagicLink[]

  @@unique([organizationId, email])
  @@index([clientId])
}

model PortalMagicLink {
  id        String    @id @default(cuid())
  contactId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  contact ClientContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model Project {
  id             String        @id @default(cuid())
  organizationId String
  clientId       String
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  budgetCents    Int?
  startDate      DateTime?
  dueDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  @@index([organizationId])
  @@index([clientId])
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  clientId       String
  projectId      String?
  number         String
  status         InvoiceStatus @default(DRAFT)
  currency       String        @default("USD")
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  notes          String?
  taxRateBps     Int           @default(0) // basis points: 1800 = 18.00%
  subtotalCents  Int           @default(0)
  taxCents       Int           @default(0)
  totalCents     Int           @default(0)
  sentAt         DateTime?
  paidAt         DateTime?
  lastReminderAt DateTime?
  stripeCheckoutSessionId String? @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([clientId])
}

model InvoiceItem {
  id             String @id @default(cuid())
  invoiceId      String
  description    String
  quantity       Decimal @db.Decimal(10, 2)
  unitPriceCents Int
  amountCents    Int
  position       Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  invoiceId      String
  amountCents    Int
  currency       String
  method         PaymentMethod
  stripePaymentIntentId String? @unique
  paidAt         DateTime      @default(now())
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId, paidAt])
  @@index([invoiceId])
}

// ─── Platform ────────────────────────────────────────────────────────────────

// Processed Stripe webhook events, for idempotency.
model StripeEvent {
  id          String   @id // Stripe event id (evt_...)
  type        String
  processedAt DateTime @default(now())
}

// Audit trail shown in the dashboard activity feed.
model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String   // e.g. "invoice.sent", "member.invited"
  entityType     String?
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}
